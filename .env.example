# ==============================================================================
# Palm Mind AI - Environment Configuration Template
# ==============================================================================

# Application Settings
APP_NAME="Palm Mind AI - RAG & Ingestion Engine"
ENVIRONMENT="development"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Relational Database (SQLAlchemy Async)
# Default: Local zero-friction SQLite async
DATABASE_URL="sqlite+aiosqlite:///./palm_mind.db"
# Production PostgreSQL (e.g. in Docker Compose):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/palm_mind"

# Redis Conversational Memory
REDIS_URL="redis://localhost:6379/0"
REDIS_CHAT_TTL_SECONDS=86400
ALLOW_IN_MEMORY_REDIS_FALLBACK=true

# Vector Database (Qdrant)
# Leave QDRANT_URL empty to use local embedded Qdrant persistence in ./qdrant_storage
QDRANT_URL=""
# Remote / Docker Qdrant URL:
# QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="palm_mind_documents"
QDRANT_EMBEDDED_PATH="./qdrant_storage"
VECTOR_DIMENSION=1536

# OpenAI / Compatible LLM & Embedding Settings
# Provide your OpenAI API key or compatible provider key (e.g., Groq, OpenRouter, Ollama)
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
EMBEDDING_MODEL="text-embedding-3-small"
LLM_MODEL="gpt-4o-mini"
# When OPENAI_API_KEY is omitted, intelligent deterministic mock responses are used
MOCK_LLM_IF_NO_KEY=true

# Document Ingestion Defaults
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
MAX_FILE_SIZE_BYTES=15728640
