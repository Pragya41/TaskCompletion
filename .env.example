# ==============================================================================
# Palm Mind AI - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="Palm Mind AI - RAG & Ingestion Engine"
ENVIRONMENT="development"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Relational Database (SQLAlchemy Async)
# Local SQLite async default:
DATABASE_URL="sqlite+aiosqlite:///./palm_mind.db"
# Or PostgreSQL in Docker:
# DATABASE_URL="postgresql+asyncpg://palm_user:palm_secret@localhost:5432/palm_mind_db"

# Redis Conversational Memory (run: docker compose up -d redis)
REDIS_URL="redis://localhost:6379/0"
REDIS_CHAT_TTL_SECONDS=86400
ALLOW_IN_MEMORY_REDIS_FALLBACK=false

# Vector Database: Qdrant (run: docker compose up -d qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="palm_mind_documents"
QDRANT_EMBEDDED_PATH="./qdrant_storage"
VECTOR_DIMENSION=1536

# OpenAI Configuration (REQUIRED for RAG & Embeddings)
# Note: Use OpenAI text-embedding-3-small (1536 dims). Do not use Groq for embeddings.
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL=""
EMBEDDING_MODEL="text-embedding-3-small"
LLM_MODEL="gpt-4o-mini"
MOCK_LLM_IF_NO_KEY=false

# Document Ingestion Defaults
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
MAX_FILE_SIZE_BYTES=15728640
